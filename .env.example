# Copy to .env.local. Never commit real values.
# PayPal sandbox (leave unset for fixtures mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# PAYPAL_MODE=live-sandbox|fixtures (defaults to live-sandbox when the PayPal creds are set)
PAYPAL_MODE=
# Required in live-sandbox mode and on Vercel: openssl rand -hex 32
TAB_SECRET=
# Cloudflare Workers AI (leave unset to use the deterministic fake models)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
